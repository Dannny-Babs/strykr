# Pooled PostgreSQL URL for application traffic.
DATABASE_URL=

# Direct PostgreSQL URL for Drizzle migrations.
DATABASE_URL_UNPOOLED=

# Private Vercel Blob token. Optional locally; required in production.
BLOB_READ_WRITE_TOKEN=

# Supabase Auth. Use the project URL and modern sb_publishable_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional remote malware-scanner contract. Cordena POSTs the raw file and expects
# JSON shaped as { "safe": true, "engine": "..." }. Set required=true to fail closed.
MALWARE_SCAN_URL=
MALWARE_SCAN_API_TOKEN=
MALWARE_SCAN_REQUIRED=false

# Development-only persona selection. Never use this as production authentication.
CORDENA_DEV_AUTH=true
CORDENA_DEFAULT_PERSONA=dealer_admin

# Optional integration boundaries are intentionally omitted until enabled:
# PYTHON_EXPORT_PATH and AI_PROVIDER_API_KEY.
