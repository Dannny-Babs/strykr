# SQLite is the local pilot default. Replace with a PostgreSQL adapter for deployment.
DATABASE_URL=./data/dealersync.db
DOCUMENT_STORAGE_PATH=./storage/documents
APP_URL=http://localhost:3000

# Development-only persona selection. Never use this as production authentication.
DEALERSYNC_DEV_AUTH=true
DEALERSYNC_DEFAULT_PERSONA=dealer_admin

# Reserved integration boundaries; no live connectors are implemented.
PYTHON_EXPORT_PATH=./data/python-extraction.json
AI_PROVIDER_API_KEY=
